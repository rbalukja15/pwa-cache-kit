{
  "name": "@rbalukja/pwa-cache-kit",
  "version": "0.0.0",
  "description": "Offline-first three-tier cache (memory, SessionStorage, IndexedDB) for PWAs.",
  "license": "MIT",
  "author": "Romarjo Balukja",
  "homepage": "https://github.com/rbalukja15/pwa-cache-kit#readme",
  "bugs": {
    "url": "https://github.com/rbalukja15/pwa-cache-kit/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./inspector": {
      "types": "./dist/inspector.d.ts",
      "import": "./dist/inspector.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rbalukja15/pwa-cache-kit.git",
    "directory": "packages/pwa-cache-kit"
  },
  "keywords": [
    "pwa",
    "cache",
    "offline",
    "indexeddb",
    "sessionstorage",
    "typescript"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
